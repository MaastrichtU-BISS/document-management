{
  "name": "@legalblocks/document-management",
  "version": "2.0.0",
  "description": "Upload, list, view and delete corpus documents; storage-agnostic (browser or database) with one artifact per document. Extracted from Lawnotation.",
  "private": false,
  "type": "module",
  "license": "MIT",
  "legalblocks": {
    "package_id": "document-management",
    "manifest": "package.manifest.json",
    "execution_type": "frontend",
    "provides_screen": "list"
  },
  "main": "DocumentManagement.vue",
  "files": [
    "package.manifest.json",
    "src",
    "pages",
    "*.ts",
    "README.md"
  ],
  "scripts": {
    "test": "echo \"no tests\" && exit 0"
  },
  "dependencies": {
    "@legalblocks/module-runtime": "^0.1.0"
  },
  "devDependencies": {
    "@lawnotation/module-sdk": "^1.0.0",
    "typescript": "^5.4.0"
  }
}
